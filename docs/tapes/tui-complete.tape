# Tab at the : prompt walks the candidates.
Output docs/media/tui-complete.gif
Set Shell zsh
Set FontSize 16
Set Width 1100
Set Height 340
Set Padding 12
Set TypingSpeed 60ms
Hide
Type "clear" Enter
Show
Type "vuwr examples/products.xml" Enter
Sleep 1.2s
Type "3"
Sleep 800ms
Type ":form"
Sleep 600ms
Tab
Sleep 900ms
Tab
Sleep 900ms
Tab
Sleep 900ms
Escape
Sleep 400ms
Type ":theme "
Sleep 500ms
Tab
Sleep 800ms
Tab
Sleep 800ms
Tab
Sleep 800ms
Enter
Sleep 1.5s
Type "q"
Sleep 600ms
